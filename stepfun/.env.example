# ── seekdb 连接方式 ─────────────────────────────────────────────
# server   : 连接本地/远程 seekdb 服务（Windows 推荐）
# embedded : 进程内嵌 seekdb（Linux / macOS 支持，Windows 不支持）
SEEKDB_MODE=server

SEEKDB_HOST=127.0.0.1
SEEKDB_PORT=2881
SEEKDB_USER=root
SEEKDB_PASSWORD=
SEEKDB_DATABASE=test
# 连接 OceanBase 时填写租户；连接 seekdb server 时留空
SEEKDB_TENANT=

# embedded 模式的数据目录（仅 SEEKDB_MODE=embedded 生效）
SEEKDB_PATH=./data/seekdb

# ── Web 服务 ────────────────────────────────────────────────────
PORT=5178

# ── 模型 ────────────────────────────────────────────────────────
MODEL_ID=bge-small-zh-v1.5
MODEL_DIM=512
