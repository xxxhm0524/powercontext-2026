# Copy to .env and fill in locally; never commit real credentials.
MINIMAX_API_KEY=
MINIMAX_MODEL=MiniMax-M3.1-Flash
MINIMAX_BASE_URL=https://api.minimaxi.com/anthropic
MINIMAX_API_STYLE=anthropic
# Optional: point at an existing seekdb / OceanBase instance.
SEEKDB_DSN=
# Optional: embedded seekdb directory on Linux/macOS.
SEEKDB_PATH=
